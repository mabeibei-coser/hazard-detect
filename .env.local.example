# ── 后端 BananaRouter Gemini API（server.js 用，浏览器 bundle 不包含 key）──
# 与 A900 使用同一套 Gemini-native 供应商配置；真实 key 只放 .env.local
BANANAROUTER_API_KEY=<api-key>
BANANAROUTER_BASE_URL=https://api.bananarouter.com
BANANAROUTER_MODEL=gemini-3.1-flash-lite

# ── iron-session 密钥 ──
# 必须 ≥32 字符。建议命令生成（避免 $ 字符触发 dotenv 展开）：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
HAZARD_SESSION_PASSWORD=<generate-with-the-command-above>
# 本地 dev 留 false；HTTPS 部署改 true 或删掉这行（默认严格）
HAZARD_COOKIE_SECURE=false

# ── API 服务端口（与 vite.config.js 的 proxy target 对应）──
# vite dev 跑 :3000，server.js 跑 :4001，vite 把 /api/* 转发到 server.js
PORT=4001

# ── 部署到 /a600/ 子路径时打开 ──
# VITE_BASE_PATH=/a600/
# HAZARD_COOKIE_PATH=/a600
