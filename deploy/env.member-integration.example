# ════════════════════════════════════════════════════════════
# A600 隐患识别 —— 接入会员中心后的生产 env 增量
# ⚠️ 这是 feat/member-center-integration 分支用的，合并部署时才生效。
# 部署网址：https://h100.jsai100.com/a600/   端口：4001（不变）
# ════════════════════════════════════════════════════════════

NODE_ENV=production
HAZARD_API_PORT=4001
VITE_BASE_PATH=/a600/

# ── BananaRouter Gemini 视觉模型 ──
BANANAROUTER_API_KEY=<A600 BananaRouter key>
BANANAROUTER_BASE_URL=https://api.bananarouter.com
BANANAROUTER_MODEL=gemini-3.1-flash-lite

# ── 共享会员 cookie（替代原 HAZARD_SESSION_PASSWORD）──
# 必须与会员中心 asg100 的 ASG_MEMBER_SESSION_PASSWORD【完全一致】，否则中心登录 A600 不认。
ASG_MEMBER_SESSION_PASSWORD=<与 asg100 同一个值>
ASG_COOKIE_PATH=/
ASG_COOKIE_SECURE=true

# ── 会员中心地址（A600 问 VIP / 跳登录用）──
# 后端 server-to-server 用内网 localhost 更快；前端跳转用公网 URL。
ASG_CENTER_BASE_URL=http://127.0.0.1:4002
VITE_CENTER_URL=https://h100.jsai100.com/asg100/
